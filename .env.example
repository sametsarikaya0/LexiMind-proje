# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Web server port (Node/Express frontend proxy)
PORT=3000

# PYTHON_PORT: Python FastAPI backend port
PYTHON_PORT=8001

# ALLOWED_ORIGINS: CORS origins for the API (default: *)
ALLOWED_ORIGINS="*"

# VITE_API_BASE_URL: (Optional) Python FastAPI API base URL for client direct calls.
# If empty, frontend uses relative calls proxied by Node/Express server.
VITE_API_BASE_URL=""
